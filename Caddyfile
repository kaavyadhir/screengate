# Site address. Set SITE_ADDRESS in .env on the server.
#
#   SITE_ADDRESS=:80                      bare IP, plain HTTP, no cert
#   SITE_ADDRESS=screengate.duckdns.org   real hostname, automatic HTTPS
#
# Caddy obtains and renews the Let's Encrypt certificate itself, so there
# is no certbot step and nothing to remember to renew. It needs a real
# hostname resolving to this server to do it - a free DuckDNS subdomain
# is enough, and is what the README suggests.
#
# NOTE: rate limiting is deliberately NOT done here. Caddy's `rate_limit`
# directive comes from a third-party module that the standard caddy image
# does not ship, and Caddy refuses to start on an unrecognised directive
# rather than ignoring it - so configuring it here would stop the whole
# stack from coming up. The limit lives in screengate/ratelimit.py
# instead, which also means it is covered by the test suite.

{$SITE_ADDRESS::80} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# The demo page is self-contained: no third-party scripts, no
		# remote fonts, no outbound calls. Saying so explicitly means a
		# future edit that pulls in a CDN fails visibly here rather than
		# silently widening what the page may load.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Caddy appends the real peer address to X-Forwarded-For, so the app
	# reads the RIGHTMOST entry as the client identity. A client that
	# sends its own X-Forwarded-For cannot forge that last entry.
	reverse_proxy screengate:8000
}
