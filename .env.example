# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Get a Gemini API key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Which target the gateway protects.
#   mock    - deterministic simulated screener, no network, used by CI
#   gemini  - the real model
SCREENGATE_PROVIDER=mock

# Embedding backend for the semantic layer.
#   auto     - Gemini when a key is present, hashing stub otherwise
#   gemini   - force real semantic embeddings
#   hashing  - force the offline stub (NOT semantic; results not reportable)
SCREENGATE_EMBEDDER=auto

# Vector store. auto uses Chroma when installed, in-memory otherwise.
SCREENGATE_VECTOR_STORE=auto
SCREENGATE_CHROMA_PATH=.chroma

# Pin an exact model, not the `gemini-flash-latest` alias: an alias moves,
# and a published number measured against a moving target cannot be
# reproduced. The README's figures come from the model named here.
SCREENGATE_GEMINI_MODEL=gemini-3.5-flash-lite

# The semantic layer's threshold (Policy.semantic_threshold = 0.68) was
# calibrated against the embedding model named here. Changing it
# invalidates that calibration - cosine distances are not comparable
# across embedding models - so re-run bench/tune_semantic.py if you
# change it, and state which model produced any published number.
#
# Note: this model does not batch, so layer 4 costs one API call per
# document line. See .embed_cache/ and the README's limits section.
SCREENGATE_EMBEDDING_MODEL=gemini-embedding-2

SCREENGATE_LOG_PATH=audit.log

# Public-demo rate limit, per client, applied to /v1/ only.
SCREENGATE_RATE_LIMIT_EVENTS=30
SCREENGATE_RATE_LIMIT_WINDOW_S=60
